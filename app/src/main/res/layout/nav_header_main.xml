        android:textColor="@color/text_primary"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/desc_high_precision"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

</LinearLayout>
