<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- BARRA SUPERIOR (TOOLBAR PERSONALIZADA) -->
    <com.google.android.material.appbar.AppBarLayout
        android:theme="@style/AppTheme.AppBarOverlay"
        android:background="@color/nav_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/nav_background"
            app:layout_scrollFlags="enterAlways|scroll"
            app:navigationIcon="@drawable/ic_menu"
            app:popupTheme="@style/AppTheme.PopupOverlay">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Factor"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Escala"
                    android:textColor="@color/nav_selected"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- CONTENIDO CENTRAL (VIEWPAGER) -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="60dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- CONTENEDOR INFERIOR (TABLAYOUT) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/nav_background"
        android:orientation="vertical">
        <!-- LÍNEA DIVISORIA SUTIL -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1F2937" /> <!-- Color gris discreto para tema oscuro -->

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nav_background"
            app:tabIconTint="@color/tab_color_selector"
            app:tabTextColor="@color/tab_color_selector"
            app:tabSelectedTextColor="@color/nav_selected"
            app:tabRippleColor="@null"
            app:tabInlineLabel="@bool/tab_inline_label"
            app:tabTextAppearance="@style/CustomTabTextAppearance"
            app:tabMode="fixed"
            app:tabIndicatorColor="#3B82F6"
            app:tabIndicatorHeight="3dp"
            app:tabIndicatorFullWidth="true">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_auto"
                android:text="@string/tab_text_1" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_manual"
                android:text="@string/tab_text_2" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_register"
                android:text="@string/tab_text_3" />

        </com.google.android.material.tabs.TabLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
