<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_confirm_border"
    android:gravity="center_horizontal">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_search_pro"
            android:padding="6dp"
            android:background="@drawable/bg_spinner_with_arrow"
            android:backgroundTint="#33FFFFFF"
            app:tint="@color/accent_orange"
            android:contentDescription="Ir a" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Navegar a Coordenadas"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Latitude Input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LATITUD (DECIMAL)"
        android:textColor="#E0E0E0"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/et_go_lat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_spinner_with_arrow"
        android:backgroundTint="#22FFFFFF"
        android:hint="Ej: -16.504260"
        android:padding="12dp"
        android:textColor="@color/accent_orange"
        android:textColorHint="#99E0E0E0"
        android:textStyle="bold"
        android:inputType="numberDecimal|numberSigned"
        android:maxLines="1" />

    <!-- Longitude Input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LONGITUD (DECIMAL)"
        android:textColor="#E0E0E0"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/et_go_lon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_spinner_with_arrow"
        android:backgroundTint="#22FFFFFF"
        android:hint="Ej: -68.090811"
        android:padding="12dp"
        android:textColor="@color/accent_orange"
        android:textColorHint="#99E0E0E0"
        android:textStyle="bold"
        android:inputType="numberDecimal|numberSigned"
        android:maxLines="1" />

    <!-- Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_go_to_pos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="IR A POSICIÓN"
        android:textAllCaps="false"
        app:icon="@drawable/ic_search_pro"
        app:iconGravity="textStart"
        app:backgroundTint="@color/accent_orange"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:cornerRadius="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_go_cancel"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_cancel"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:strokeColor="@color/accent_orange"
        app:strokeWidth="1.2dp"
        app:cornerRadius="8dp" />

</LinearLayout>
