<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_visibility_pro"
                android:padding="4dp"
                android:background="@drawable/bg_spinner_with_arrow"
                android:backgroundTint="@color/bg_surface_secondary"
                app:tint="@color/accent_primary"
                android:contentDescription="Ir a" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Navegar a Coordenadas"
                android:textColor="@color/accent_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Latitude Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LATITUD (DECIMAL)"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_go_lat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_spinner_with_arrow"
            android:backgroundTint="@color/bg_surface_secondary"
            android:hint="Ej: -16.504260"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:inputType="numberDecimal|numberSigned"
            android:maxLines="1" />

        <!-- Longitude Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LONGITUD (DECIMAL)"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_go_lon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_spinner_with_arrow"
            android:backgroundTint="@color/bg_surface_secondary"
            android:hint="Ej: -68.090811"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:inputType="numberDecimal|numberSigned"
            android:maxLines="1" />

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btn_go_to_pos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="IR A POSICIÓN"
            android:textAllCaps="false"
            app:icon="@drawable/ic_search_pro"
            app:iconGravity="textStart"
            app:backgroundTint="@color/accent_orange"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_go_cancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            app:strokeColor="@color/divider" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
