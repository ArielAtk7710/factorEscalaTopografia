<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_confirm_border"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_constellation_status"
        android:textColor="@color/accent_orange"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Resumen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bg_surface"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_satellites_used"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txt_sat_used"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/flight_green"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider"
            android:layout_marginHorizontal="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_total_visible"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txt_sat_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/accent_light"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Lista de Satélites -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_satellites"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@color/bg_surface" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_sat_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_understood"
        android:layout_marginTop="20dp"
        app:backgroundTint="@color/accent_orange"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:cornerRadius="8dp" />

</LinearLayout>
