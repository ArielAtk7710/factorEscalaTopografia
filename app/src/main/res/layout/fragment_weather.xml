<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_weather"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_main"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. TARJETA PRINCIPAL DINÁMICA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_main_weather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="4dp"
                app:strokeColor="@color/flight_green"
                app:cardBackgroundColor="@color/bg_weather_clear"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="24dp">

                        <ImageView
                            android:id="@+id/img_main_weather_icon"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:srcCompat="@drawable/ic_weather_clear"
                            tools:ignore="ContentDescription" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView
                                android:id="@+id/txt_location_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_searching_location"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                android:layout_marginBottom="2dp"
                                android:alpha="0.8" />

                            <TextView
                                android:id="@+id/txt_current_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Martes, 11 de Agosto"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:layout_marginBottom="4dp"
                                android:alpha="0.7"
                                tools:visibility="visible" />

                            <TextView
                                android:id="@+id/txt_main_temp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="16,9°C"
                                android:textColor="@android:color/white"
                                android:textSize="42sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txt_main_condition"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cielo despejado"
                                android:textColor="@android:color/white"
                                android:textSize="16sp"
                                android:alpha="0.9" />

                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Banner de Advertencia GPS -->
                    <LinearLayout
                        android:id="@+id/layout_gps_warning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/overlay_bg_dark"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            app:srcCompat="@drawable/ic_toast_warning"
                            app:tint="@color/accent_orange"
                            android:layout_marginEnd="8dp"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/txt_gps_warning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Precaución. Interferencias GPS posibles."
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. ASISTENTE DE VUELO -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_assistant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bg_surface"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/img_assistant_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:srcCompat="@drawable/ic_info"
                        app:tint="@color/accent_orange"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/txt_assistant_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/safety_assistant_title"
                            android:textColor="@color/accent_orange"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_flight_rec"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ventana óptima detectada..."
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/txt_view_details"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_view_details"
                            android:textSize="11sp"
                            android:textStyle="bold|italic"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. PRONÓSTICO 24 HORAS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_forecast_24h"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_hourly_weather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_hourly_weather"
                android:layout_marginBottom="16dp" />

            <!-- 4. PRONÓSTICO 7 DÍAS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_forecast_7d"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_weekly_forecast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_daily_weather"
                android:layout_marginBottom="16dp" />

            <!-- 5. SEGURIDAD GNSS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_electronic_safety"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bg_surface"
                android:layout_marginBottom="16dp">

                <include layout="@layout/item_weather_detail_pro" android:id="@+id/detail_kp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- 6. CONFORT TÉRMICO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_thermal_comfort"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bg_surface"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <!-- Sensación -->
                    <include layout="@layout/item_weather_detail_pro" android:id="@+id/detail_apparent" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginHorizontal="12dp" />

                    <!-- Nubosidad -->
                    <include layout="@layout/item_weather_detail_pro" android:id="@+id/detail_cloud" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginHorizontal="12dp" />

                    <!-- Visibilidad -->
                    <include layout="@layout/item_weather_detail_pro" android:id="@+id/detail_vis" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 7. VIENTOS Y PRECIPITACIÓN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_wind_precip"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bg_surface"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <include layout="@layout/item_weather_detail_pro" android:id="@+id/detail_wind_120" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginHorizontal="12dp" />
                    <include layout="@layout/item_weather_detail_pro" android:id="@+id/detail_wind_sust" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginHorizontal="12dp" />
                    <include layout="@layout/item_weather_detail_pro" android:id="@+id/detail_wind_dir" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginHorizontal="12dp" />
                    <include layout="@layout/item_weather_detail_pro" android:id="@+id/detail_gusts" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginHorizontal="12dp" />
                    <include layout="@layout/item_weather_detail_pro" android:id="@+id/detail_rain_prob" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginHorizontal="12dp" />
                    <include layout="@layout/item_weather_detail_pro" android:id="@+id/detail_rain_act" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 8. BOTÓN ACTUALIZAR -->
            <Button
                android:id="@+id/btn_refresh_weather"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/btn_refresh_weather_pro"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_primary"
                app:cornerRadius="8dp"
                android:layout_marginBottom="80dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 9. OVERLAY DE CARGA -->
    <LinearLayout
        android:id="@+id/layout_weather_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_bg_dark"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminateTint="@color/accent_orange" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/msg_loading_weather_long"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

    </LinearLayout>

</FrameLayout>
