<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    tools:theme="@style/AppTheme">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- SECCIÓN PRINCIPAL -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <CheckBox
                android:id="@+id/cb_item_select_lib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/txt_item_lib_resumen"
                android:buttonTint="@color/accent_light"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/txt_item_lib_nombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="GPS-01 -> AUX-01"
                android:textColor="@color/accent_orange"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toEndOf="@id/cb_item_select_lib"
                app:layout_goneMarginStart="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/layout_actions_lib" />

            <TextView
                android:id="@+id/txt_item_lib_resumen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Ref: GPS-02 | Alt. Prisma: 1.600m"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toEndOf="@id/cb_item_select_lib"
                app:layout_goneMarginStart="0dp"
                app:layout_constraintTop_toBottomOf="@id/txt_item_lib_nombre"
                app:layout_constraintEnd_toStartOf="@+id/layout_actions_lib" />

            <LinearLayout
                android:id="@+id/layout_actions_lib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/btn_item_lib_copy"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/text_secondary"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Copiar" />

                <ImageView
                    android:id="@+id/btn_item_lib_share"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_share"
                    app:tint="@color/text_secondary"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Compartir" />

                <ImageView
                    android:id="@+id/btn_item_lib_delete"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/state_error"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Eliminar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_expand_lib_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_actions_lib">

                <TextView
                    android:id="@+id/txt_lib_expand_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver Detalles"
                    android:textColor="@color/accent_light"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/img_lib_expand_arrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_expand_more"
                    app:tint="@color/accent_light"
                    android:contentDescription="Expandir" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- SECCIÓN DETALLADA -->
        <LinearLayout
            android:id="@+id/layout_lib_details_expand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="12dp" />

            <!-- GRID DE DATOS TÉCNICOS -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView android:text="TIPO REGISTRO" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/txt_lib_det_tipo" android:text="Radiación" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView android:text="ALT. INSTRUMENTO" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/txt_lib_det_alt_ins" android:text="1.545 m" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView android:text="ESTE (E)" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/txt_lib_det_este" android:text="590745.00" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView android:text="NORTE (N)" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/txt_lib_det_norte" android:text="8175432.00" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">
                    <TextView android:text="COTA (Z)" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/txt_lib_det_cota" android:text="3600.00" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">
                    <TextView android:text="FECHA" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/txt_lib_det_fecha" android:text="2026-08-01" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </GridLayout>

            <!-- SECCIÓN DE OBSERVACIONES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:background="@color/bg_surface_secondary"
                android:padding="8dp">
                <TextView android:text="OBSERVACIONES DE CAMPO" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/txt_lib_det_obs" android:text="Sin observaciones." android:textColor="@color/text_primary" android:textSize="12sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>