<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calendario GNSS"
        android:textColor="@color/accent_orange"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Botón Seleccionar Fecha -->
    <Button
        android:id="@+id/btn_select_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleccionar Fecha"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        app:backgroundTint="@color/accent_primary"
        app:icon="@drawable/ic_calendar"
        app:iconGravity="textStart"
        android:layout_marginBottom="24dp" />

    <!-- Resultados en Formato Lista (Columnas Etiqueta | Valor) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_surface"
        android:padding="16dp">

        <!-- Número de Día Juliano -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Número de Día Juliano:"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txt_julian_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2461254.5"
                android:textColor="@color/accent_light"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Día del Año (DOY) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Día del Año (DOY):"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txt_doy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="214"
                android:textColor="@color/accent_light"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Semana GPS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Semana GPS:"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txt_gps_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2430"
                android:textColor="@color/accent_light"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Número de Semana GPS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Número de Semana GPS:"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txt_gps_week_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24300"
                android:textColor="@color/accent_light"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/txt_current_date_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Domingo, 2 de Agosto de 2026 (UTC)"
        android:textColor="@color/accent_orange"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cálculos basados en el estándar IGS/GNSS"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:gravity="center"
        android:layout_marginTop="8dp" />

</LinearLayout>
