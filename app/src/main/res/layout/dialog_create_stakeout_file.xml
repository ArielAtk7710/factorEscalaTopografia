<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg_surface">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CREADOR DE ARCHIVOS TXT MODO REPLANTEO"
        android:textColor="@color/accent_orange"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Recuadro de Ejemplo (Azul Premium) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/accent_primary"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FORMATO REQUERIDO:"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:alpha="0.8" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="      ID, ESTE E, NORTE N, UTM, ZONA, HEM"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ej: P01, 592534.12E, 8175960.4N, UTM, 19, S"
                android:textColor="@color/accent_orange"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <EditText
        android:id="@+id/et_new_file_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre del archivo (ej: Obra_Rio)"
        android:inputType="text"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AÑADIR NUEVO PUNTO"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/et_new_point_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ID del Punto (ej: P01)"
        android:inputType="text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <EditText
            android:id="@+id/et_new_point_east"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Este (X)"
            android:inputType="numberDecimal" />
        <EditText
            android:id="@+id/et_new_point_north"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Norte (Y)"
            android:layout_marginStart="8dp"
            android:inputType="numberDecimal" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/sp_new_point_zone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_spinner_with_arrow" />

        <Spinner
            android:id="@+id/sp_new_point_hemisphere"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_spinner_with_arrow" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_point_to_list"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AÑADIR A LA LISTA"
        android:layout_marginTop="12dp"
        app:strokeColor="@color/accent_primary"
        android:textColor="@color/accent_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PUNTOS EN COLA"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@color/bg_main"
        android:padding="4dp">
        <TextView
            android:id="@+id/txt_points_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sin puntos añadidos"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_generate_stakeout_txt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GENERAR ARCHIVO TXT"
        android:layout_marginTop="20dp"
        app:backgroundTint="@color/accent_orange"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_creator"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CANCELAR"
        android:layout_marginTop="4dp"
        app:strokeColor="@color/state_error"
        android:textColor="@color/state_error" />

</LinearLayout>
