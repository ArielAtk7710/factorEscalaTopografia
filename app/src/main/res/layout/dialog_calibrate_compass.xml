<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1B1E23"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calibrar Brújula"
        android:textColor="@color/accent_orange"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Para mejorar la precisión, mueva su dispositivo dibujando un '8' (ocho) en el aire varias veces."
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Animación o Imagen de Referencia (Placeholder por ahora con icono) -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_compass_needle"
        app:tint="@color/accent_light"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_close_calibrate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ENTENDIDO"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        app:backgroundTint="@color/accent_primary" />

</LinearLayout>
