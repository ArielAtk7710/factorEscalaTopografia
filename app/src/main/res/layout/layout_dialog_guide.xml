<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg_surface">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_quick_guide"
        android:textColor="@color/accent_orange"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="500dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: General -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_gen_title"
                android:textColor="@color/accent_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_gen_body"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <!-- Section 2: Calc -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_calc_title"
                android:textColor="@color/accent_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_calc_body"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <!-- Section 3: Map -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_map_title"
                android:textColor="@color/accent_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_map_body"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <!-- Section 4: Alt -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_alt_title"
                android:textColor="@color/accent_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_alt_body"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <!-- Section 5: Drone -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_drone_title"
                android:textColor="@color/accent_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_drone_body"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <!-- Section 6: Data -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_data_title"
                android:textColor="@color/accent_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guide_section_data_body"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_guide_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_understood"
        android:layout_marginTop="16dp"
        app:backgroundTint="@color/accent_orange"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:cornerRadius="8dp" />

</LinearLayout>
