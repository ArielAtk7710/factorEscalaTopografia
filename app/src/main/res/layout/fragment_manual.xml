<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">
    <ScrollView
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="Sistema de referencia WGS84"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp"
                android:text="Proyeccion"/>
            <Spinner
                android:id="@+id/spGeoUtm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@drawable/bg_spinner_with_arrow"
                android:paddingStart="8dp"
                android:paddingEnd="32dp" />

            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layGeo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:text="Latitud"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/et_lat_gra"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:inputType="numberSigned"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:text="º  "/>
                    <EditText
                        android:id="@+id/et_lat_min"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:inputType="numberSigned"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:text="&apos;  "/>
                    <EditText
                        android:id="@+id/et_lat_seg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight="1.5"
                        android:inputType="numberDecimal"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:text="&apos;&apos;  "/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:text="Longitud"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/et_lon_gra"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:inputType="numberSigned"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:text="º  "/>
                    <EditText
                        android:id="@+id/et_lon_min"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:inputType="numberSigned"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:text="&apos;  "/>
                    <EditText
                        android:id="@+id/et_lon_seg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_weight="1.5"
                        android:inputType="numberDecimal"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:text="&apos;&apos;  "/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:text="Altura"/>
                <EditText
                    android:id="@+id/et_alt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:inputType="numberDecimal"/>
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layUtm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:rowCount="4"
                    android:columnCount="3">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:text="Este"
                        android:layout_row="0"
                        android:layout_column="0"
                        android:layout_gravity="center_vertical"/>
                    <EditText
                        android:id="@+id/et_utm_este"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_row="0"
                        android:layout_column="1"
                        android:layout_gravity="fill_horizontal"
                        android:inputType="numberDecimal"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:text="m"
                        android:layout_row="0"
                        android:layout_column="2"
                        android:layout_gravity="center_vertical"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:text="Norte"
                        android:layout_row="1"
                        android:layout_column="0"
                        android:layout_gravity="center_vertical"/>
                    <EditText
                        android:id="@+id/et_utm_norte"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_row="1"
                        android:layout_column="1"
                        android:layout_gravity="fill_horizontal"
                        android:inputType="numberDecimal"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:text="m"
                        android:layout_row="1"
                        android:layout_column="2"
                        android:layout_gravity="center_vertical"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:text="Altura"
                        android:layout_row="2"
                        android:layout_column="0"
                        android:layout_gravity="center_vertical"/>
                    <EditText
                        android:id="@+id/et_utm_alt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_row="2"
                        android:layout_column="1"
                        android:layout_gravity="fill_horizontal"
                        android:inputType="numberDecimal"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:text="m"
                        android:layout_row="2"
                        android:layout_column="2"
                        android:layout_gravity="center_vertical"/>
                </GridLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:text="Zona"
                        android:layout_weight="1"/>

                    <Spinner
                        android:id="@+id/spZona"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_spinner_with_arrow"
                        android:paddingStart="8dp"
                        android:paddingEnd="32dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:text="Hemisferio"
                        android:layout_weight="1"/>
                    <Spinner
                        android:id="@+id/spHemisferio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_spinner_with_arrow"
                        android:paddingStart="8dp"
                        android:paddingEnd="32dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/btn_calcular"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Calcular"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"/>
                <Button
                    android:id="@+id/btn_limpiar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Limpiar"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="16dp"
                android:text="Factores de corrección geométrica"/>

            <!-- Factor de Escala -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/bg_surface_secondary"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:padding="3dp"
                    android:text="Factor de Escala"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/txt_man_fe"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:padding="3dp"
                    android:text="0"
                    android:textColor="@color/accent_orange"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_man_fe_ppm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:padding="3dp"
                    android:text="0"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Factor de Altura -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/bg_surface_secondary"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:padding="3dp"
                    android:text="Factor de Altura"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/txt_man_fa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:padding="3dp"
                    android:text="0"
                    android:textColor="@color/accent_orange"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_man_fa_ppm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:padding="3dp"
                    android:text="0"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Altura Ortométrica -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/bg_surface_secondary"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:padding="3dp"
                    android:text="Altura Ortométrica"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/txt_man_alt_orto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:padding="3dp"
                    android:text="0"
                    android:textColor="@color/accent_orange"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:padding="3dp"
                    android:text="m"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Presión Atmosférica -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/bg_surface_secondary"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:padding="3dp"
                    android:text="Presión Estándar"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/txt_man_presion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:padding="3dp"
                    android:text="0"
                    android:textColor="@color/accent_orange"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:padding="3dp"
                    android:text="mmHg"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- RECUADRO DESTACADO: FACTOR COMBINADO (IDENTICO AL AUTOMATICO) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/accent_primary"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:padding="3dp"
                    android:text="Factor Combinado"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_man_fc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:padding="3dp"
                    android:text="0"
                    android:textColor="@color/accent_orange"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_man_fc_ppm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:padding="3dp"
                    android:text="0"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_guardar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/btn_save_results"
                app:backgroundTint="@color/accent_orange"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
