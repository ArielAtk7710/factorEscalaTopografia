<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:theme="@style/AppTheme"
    tools:context=".ManualFragment">
    <ScrollView
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="@string/label_wgs84"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp"
                android:text="@string/label_projection"/>
            <Spinner
                android:id="@+id/spGeoUtm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@drawable/bg_spinner_with_arrow"
                android:paddingStart="8dp"
                android:paddingEnd="32dp" />

            <!-- Geodetic Inputs -->
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layGeo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:text="@string/label_latitude"/>
                <EditText
                    android:id="@+id/et_lat_dec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:hint="Ej: -16.504260"
                    android:inputType="numberDecimal|numberSigned"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:text="@string/label_longitude"/>
                <EditText
                    android:id="@+id/et_lon_dec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:hint="Ej: -68.090811"
                    android:inputType="numberDecimal|numberSigned"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:text="@string/label_altitude"/>
                <EditText
                    android:id="@+id/et_alt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:inputType="numberDecimal"/>
            </LinearLayout>

            <!-- UTM Inputs -->
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layUtm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:rowCount="4"
                    android:columnCount="3">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:text="@string/label_east"
                        android:layout_row="0"
                        android:layout_column="0"
                        android:layout_gravity="center_vertical"/>
                    <EditText
                        android:id="@+id/et_utm_este"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_row="0"
                        android:layout_column="1"
                        android:layout_gravity="fill_horizontal"
                        android:inputType="numberDecimal"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:text="@string/unit_meter"
                        android:layout_row="0"
                        android:layout_column="2"
                        android:layout_gravity="center_vertical"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:text="@string/label_north"
                        android:layout_row="1"
                        android:layout_column="0"
                        android:layout_gravity="center_vertical"/>
                    <EditText
                        android:id="@+id/et_utm_norte"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_row="1"
                        android:layout_column="1"
                        android:layout_gravity="fill_horizontal"
                        android:inputType="numberDecimal"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:text="@string/unit_meter"
                        android:layout_row="1"
                        android:layout_column="2"
                        android:layout_gravity="center_vertical"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:text="@string/label_altitude"
                        android:layout_row="2"
                        android:layout_column="0"
                        android:layout_gravity="center_vertical"/>
                    <EditText
                        android:id="@+id/et_utm_alt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_row="2"
                        android:layout_column="1"
                        android:layout_gravity="fill_horizontal"
                        android:inputType="numberDecimal"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:text="@string/unit_meter"
                        android:layout_row="2"
                        android:layout_column="2"
                        android:layout_gravity="center_vertical"/>
                </GridLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:text="@string/label_zone"
                        android:layout_weight="1"/>

                    <Spinner
                        android:id="@+id/spZona"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_spinner_with_arrow"
                        android:paddingStart="8dp"
                        android:paddingEnd="32dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:text="@string/label_hemisphere"
                        android:layout_weight="1"/>
                    <Spinner
                        android:id="@+id/spHemisferio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_spinner_with_arrow"
                        android:paddingStart="8dp"
                        android:paddingEnd="32dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Buttons -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/btn_calcular"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_calculate"
                    app:backgroundTint="@color/accent_orange"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"/>
                <Button
                    android:id="@+id/btn_limpiar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_clean"
                    app:backgroundTint="@color/accent_orange"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp"
                android:text="@string/title_geometric_factors"/>

            <!-- GRID COMPACTO DE DATOS TÉCNICOS -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginTop="8dp"
                android:alignmentMode="alignMargins">

                <!-- 1. Factor de Escala -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@color/bg_surface_secondary"
                    android:padding="8dp"
                    android:layout_margin="2dp">
                    <TextView android:text="@string/label_scale_factor" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/txt_man_fe" android:text="0.00000000" android:textColor="@color/accent_orange" android:textSize="13sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/txt_man_fe_ppm" android:text="0 PPM" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- 2. Factor de Altura -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@color/bg_surface_secondary"
                    android:padding="8dp"
                    android:layout_margin="2dp">
                    <TextView android:text="@string/label_elevation_factor" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/txt_man_fa" android:text="0.00000000" android:textColor="@color/accent_orange" android:textSize="13sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/txt_man_fa_ppm" android:text="0 PPM" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- 3. Altura Ortométrica -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@color/bg_surface_secondary"
                    android:padding="8dp"
                    android:layout_margin="2dp">
                    <TextView android:text="@string/label_orthometric_altitude" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/txt_man_alt_orto" android:text="0.000 m" android:textColor="@color/accent_orange" android:textSize="13sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- 4. Ondulación Geoidal -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@color/bg_surface_secondary"
                    android:padding="8dp"
                    android:layout_margin="2dp">
                    <TextView android:text="@string/label_geoid_undulation" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/txt_man_geoid_undulation" android:text="0.000 m" android:textColor="@color/accent_orange" android:textSize="13sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- 5. Temperatura Ambiente (Movido aquí) -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@color/bg_surface_secondary"
                    android:padding="8dp"
                    android:layout_margin="2dp">
                    <TextView android:text="@string/label_temp_ambient" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/txt_man_temp" android:text="-- °C" android:textColor="@color/accent_orange" android:textSize="13sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- 6. Modelo Geoidal -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_columnWeight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@color/bg_surface_secondary"
                    android:padding="8dp"
                    android:layout_margin="2dp">
                    <TextView android:text="@string/label_geoid_model" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/txt_man_geoid_model" android:text="EGM96 (Global)" android:textColor="@color/accent_orange" android:textSize="11sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </GridLayout>

            <!-- RECUADRO DESTACADO: RESULTADOS CLAVE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/accent_primary"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Fila 1: Factor Combinado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_combined_factor"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">
                        <TextView
                            android:id="@+id/txt_man_fc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.000000000"
                            android:textColor="@color/accent_orange"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txt_man_fc_ppm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- PPM"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:alpha="0.8" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginVertical="8dp" />

                <!-- Fila 2: Presión -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_pressure"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/txt_man_presion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/accent_orange"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" mmHg"
                                android:textColor="@color/accent_orange"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/txt_man_presion_hpa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- HPa"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:alpha="0.8" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_guardar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/btn_save_results"
                app:backgroundTint="@color/accent_orange"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
