<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- OSMLayer -->
        <org.osmdroid.views.MapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Central Crosshair (Static) -->
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:alpha="0.9"
            android:src="@drawable/ic_crosshair" />

        <!-- Top Coordinate Display -->
        <LinearLayout
            android:id="@+id/layout_map_coords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_map_coords_status"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_map_lat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_lat_short"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="8dp"
                android:background="#44FFFFFF" />

            <TextView
                android:id="@+id/txt_map_lon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_lon_short"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/sep_map_alt"
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="8dp"
                android:background="#44FFFFFF"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_map_alt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALT: ---"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

    </FrameLayout>

    <!-- Overlay Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/map_container"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_view_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="Lista de Puntos"
            android:src="@drawable/ic_register"
            app:backgroundTint="@color/flight_green"
            app:fabSize="mini"
            app:tint="@android:color/white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_toggle_map_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="Cambiar Capa"
            android:src="@drawable/ic_map"
            app:backgroundTint="@color/accent_light"
            app:fabSize="mini"
            app:tint="@android:color/white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_mark_point"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="Información"
            android:src="@drawable/ic_info_pin"
            app:backgroundTint="@color/accent_primary"
            app:fabSize="mini"
            app:tint="@android:color/white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_center_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Centrar Ubicación"
            android:src="@drawable/ic_map_pin"
            app:backgroundTint="@color/accent_orange"
            app:tint="@android:color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
