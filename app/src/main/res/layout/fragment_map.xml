<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- OSMLayer -->
    <org.osmdroid.views.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_toggle_map_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_map"
            app:fabSize="mini"
            app:backgroundTint="@color/accent_light"
            app:tint="@android:color/white"
            android:contentDescription="Cambiar Capa" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_center_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_location_pin"
            app:backgroundTint="@color/accent_orange"
            app:tint="@android:color/white"
            android:contentDescription="Centrar Ubicación" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
