<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sistema de referencia WGS84"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:id="@+id/txt_presicion"
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="1"
                        android:layout_weight="1"
                        android:isScrollContainer="false"
                        android:layout_row="0"/>
                    <TextView
                        android:id="@+id/txt_sat"
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="1"
                        android:layout_weight="1"
                        android:layout_row="0"/>
                </LinearLayout>
                <TextView
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Coordenadas Geodésicas"/>
                <GridLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:rowCount="3"
                    android:columnCount="2">
                    <TextView
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="0"
                        android:text="Latitud"
                        android:layout_weight="1"
                        android:layout_row="0"/>
                    <TextView
                        android:id="@+id/txt_lat"
                        android:background="@android:color/white"
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="1"
                        android:text="0"
                        android:layout_weight="1"
                        android:layout_row="0"/>
                    <TextView
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="0"
                        android:text="Longitud"
                        android:layout_weight="1"
                        android:layout_row="1"/>
                    <TextView
                        android:id="@+id/txt_lon"
                        android:background="@android:color/white"
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="1"
                        android:text="0"
                        android:layout_weight="1"
                        android:layout_row="1"/>
                    <TextView
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="0"
                        android:text="Altura Elipsoidal"
                        android:layout_weight="1"
                        android:layout_row="2"/>
                    <TextView
                        android:id="@+id/txt_alt"
                        android:background="@android:color/white"
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="1"
                        android:text="0"
                        android:layout_weight="1"
                        android:layout_row="2"/>
                </GridLayout>
                <TextView
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Coordenadas UTM"/>
                <GridLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:rowCount="3"
                    android:columnCount="4">
                    <TextView
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="0"
                        android:text="Este"
                        android:layout_weight="1"
                        android:layout_row="0"/>
                    <TextView
                        android:id="@+id/txt_est"
                        android:background="@android:color/white"
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="1"
                        android:text="0"
                        android:layout_weight="1"
                        android:layout_row="0"/>
                    <TextView
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="0"
                        android:text="Norte"
                        android:layout_weight="1"
                        android:layout_row="1"/>
                    <TextView
                        android:id="@+id/txt_nort"
                        android:background="@android:color/white"
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="1"
                        android:text="0"
                        android:layout_weight="1"
                        android:layout_row="1"/>
                    <TextView
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="0"
                        android:text="Zona"
                        android:layout_weight="1"
                        android:layout_row="2"/>
                    <TextView
                        android:id="@+id/txt_zona"
                        android:background="@android:color/white"
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="1"
                        android:text="0"
                        android:layout_weight="1"
                        android:layout_row="2"/>
                    <TextView
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="2"
                        android:text="Hemisferio"
                        android:layout_weight="1"
                        android:layout_row="2"/>
                    <TextView
                        android:id="@+id/txt_hemis"
                        android:background="@android:color/white"
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="3"
                        android:text="-"
                        android:layout_weight="1"
                        android:layout_row="2"/>
                </GridLayout>
                <TextView
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Factores de correción geometrica"/>
                <GridLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:rowCount="3"
                    android:columnCount="3">
                    <TextView
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="0"
                        android:text="Factor de Escala"
                        android:layout_weight="1"
                        android:layout_row="0"/>
                    <TextView
                        android:id="@+id/txt_fe"
                        android:background="@android:color/white"
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="1"
                        android:text="0"
                        android:layout_weight="1"
                        android:layout_row="0"/>
                    <TextView
                        android:id="@+id/txt_fe_ppm"
                        android:background="@android:color/white"
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="2"
                        android:text="0"
                        android:layout_weight="1"
                        android:layout_row="0"/>
                    <TextView
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="0"
                        android:text="Factor de Altura"
                        android:layout_weight="1"
                        android:layout_row="1"/>
                    <TextView
                        android:id="@+id/txt_fa"
                        android:background="@android:color/white"
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="1"
                        android:text="0"
                        android:layout_weight="1"
                        android:layout_row="1"/>
                    <TextView
                        android:id="@+id/txt_fa_ppm"
                        android:background="@android:color/white"
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="2"
                        android:text="0"
                        android:layout_weight="1"
                        android:layout_row="1"/>
                    <TextView
                        android:textStyle="bold"
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="0"
                        android:text="Factor Combinado"
                        android:layout_weight="1"
                        android:layout_row="2"/>
                    <TextView
                        android:textStyle="bold"
                        android:id="@+id/txt_fc"
                        android:background="@android:color/white"
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="1"
                        android:text="0"
                        android:layout_weight="1"
                        android:layout_row="2"/>
                    <TextView
                        android:textStyle="bold"
                        android:id="@+id/txt_fc_ppm"
                        android:background="@android:color/white"
                        android:padding="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_column="2"
                        android:text="0"
                        android:layout_weight="1"
                        android:layout_row="2"/>
                </GridLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
