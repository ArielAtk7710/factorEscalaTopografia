<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:theme="@style/AppTheme">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_notebook"
                    app:tint="@color/accent_light" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIBRETA DE CAMPO"
                    android:textColor="@color/accent_light"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- 1. ESTACIÓN BASE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. ESTACIÓN BASE (OCUPACIÓN)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                    <TextView android:text="ID Estación" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
                    <EditText android:id="@+id/et_lib_estacion" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_spinner_with_arrow" android:backgroundTint="@color/bg_surface_secondary" android:padding="12dp" android:textColor="@color/text_primary" android:inputType="text" android:hint="GPS-01"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Alt. Instrumento (m)" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
                    <EditText android:id="@+id/et_lib_alt_ins" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_spinner_with_arrow" android:backgroundTint="@color/bg_surface_secondary" android:padding="12dp" android:textColor="@color/text_primary" android:inputType="numberDecimal" android:hint="1.545"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 2. ORIENTACIÓN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. ORIENTACIÓN (VISTA ATRÁS)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                    <TextView android:text="Punto Referencia" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
                    <EditText android:id="@+id/et_lib_punto_ref" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_spinner_with_arrow" android:backgroundTint="@color/bg_surface_secondary" android:padding="12dp" android:textColor="@color/text_primary" android:inputType="text" android:hint="GPS-02"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Alt. Prisma (m)" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
                    <EditText android:id="@+id/et_lib_alt_prisma" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_spinner_with_arrow" android:backgroundTint="@color/bg_surface_secondary" android:padding="12dp" android:textColor="@color/text_primary" android:inputType="numberDecimal" android:hint="1.600"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 3. PUNTO AUXILIAR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. PUNTO AUXILIAR / DETALLE"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:orientation="vertical" android:layout_marginEnd="8dp">
                    <TextView android:text="ID Punto Auxiliar" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
                    <EditText android:id="@+id/et_lib_punto_aux" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_spinner_with_arrow" android:backgroundTint="@color/bg_surface_secondary" android:padding="12dp" android:textColor="@color/accent_orange" android:textStyle="bold" android:inputType="text" android:hint="AUX-01"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Tipo de Registro" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/sp_lib_tipo_reg" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_spinner_with_arrow" android:backgroundTint="@color/bg_surface_secondary" android:padding="12dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- COORDENADAS (MANUAL) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dashed_border"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Este (E):" android:textColor="@color/accent_light" android:textSize="13sp" android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/et_lib_este"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="end"
                        android:hint="0.000"
                        android:inputType="numberDecimal"
                        android:minWidth="120dp"
                        android:textColor="@color/accent_orange"
                        android:textColorHint="@color/accent_orange"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" m" android:textColor="@color/accent_orange" android:textSize="16sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Norte (N):" android:textColor="@color/accent_light" android:textSize="13sp" android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/et_lib_norte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="end"
                        android:hint="0.000"
                        android:inputType="numberDecimal"
                        android:minWidth="120dp"
                        android:textColor="@color/accent_orange"
                        android:textColorHint="@color/accent_orange"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" m" android:textColor="@color/accent_orange" android:textSize="16sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Altura / Cota (Z):" android:textColor="@color/accent_light" android:textSize="13sp" android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/et_lib_cota"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="end"
                        android:hint="0.000"
                        android:inputType="numberDecimal"
                        android:minWidth="120dp"
                        android:textColor="@color/accent_orange"
                        android:textColorHint="@color/accent_orange"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" m" android:textColor="@color/accent_orange" android:textSize="16sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- OBSERVACIONES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Observaciones de Campo"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/et_lib_obs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_spinner_with_arrow"
                android:backgroundTint="@color/bg_surface_secondary"
                android:hint="Ej: Clavo sobre estaca cerca al río."
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top|start" />

            <!-- BOTONES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/btn_lib_cancelar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cancelar"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground" />

                <Button
                    android:id="@+id/btn_lib_guardar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:text="Guardar en Libreta"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_orange"
                    android:textColor="@android:color/white" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
