<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:theme="@style/AppTheme">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- HEADER UNIFICADO -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_header_notebook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIBRETA DE CAMPO"
                    android:textColor="@color/accent_orange"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/btn_notebook_info"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Información"
                    android:focusable="true"
                    android:src="@drawable/ic_info_round_blue"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 1. ESTACIÓN BASE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_station_base"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                    <TextView android:text="@string/label_station_id" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
                    <EditText android:id="@+id/et_lib_estacion" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_spinner_with_arrow" android:backgroundTint="@color/bg_surface_secondary" android:padding="12dp" android:textColor="@color/text_primary" android:inputType="text" android:hint="GPS-01"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="@string/label_alt_ins_m" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
                    <EditText android:id="@+id/et_lib_alt_ins" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_spinner_with_arrow" android:backgroundTint="@color/bg_surface_secondary" android:padding="12dp" android:textColor="@color/text_primary" android:inputType="numberDecimal" android:hint="1.545"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 2. ORIENTACIÓN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_orientation"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                    <TextView android:text="@string/label_ref_point" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
                    <EditText android:id="@+id/et_lib_punto_ref" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_spinner_with_arrow" android:backgroundTint="@color/bg_surface_secondary" android:padding="12dp" android:textColor="@color/text_primary" android:inputType="text" android:hint="GPS-02"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="@string/label_alt_prisma_m" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
                    <EditText android:id="@+id/et_lib_alt_prisma" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_spinner_with_arrow" android:backgroundTint="@color/bg_surface_secondary" android:padding="12dp" android:textColor="@color/text_primary" android:inputType="numberDecimal" android:hint="1.600"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 3. PUNTO AUXILIAR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_point_aux"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:orientation="vertical" android:layout_marginEnd="8dp">
                    <TextView android:text="@string/label_point_aux_id" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
                    <EditText android:id="@+id/et_lib_punto_aux" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_spinner_with_arrow" android:backgroundTint="@color/bg_surface_secondary" android:padding="12dp" android:textColor="@color/accent_orange" android:textStyle="bold" android:inputType="text" android:hint="AUX-01"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="@string/label_reg_type" android:textSize="10sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/sp_lib_tipo_reg" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_spinner_with_arrow" android:paddingStart="12dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:paddingEnd="36dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- COORDENADAS (MANUAL) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dashed_border"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/label_east_e" android:textColor="@color/accent_light" android:textSize="13sp" android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/et_lib_este"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="end"
                        android:hint="0.000"
                        android:inputType="numberDecimal"
                        android:minWidth="120dp"
                        android:textColor="@color/accent_orange"
                        android:textColorHint="@color/accent_orange"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" m" android:textColor="@color/accent_orange" android:textSize="16sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/label_north_n" android:textColor="@color/accent_light" android:textSize="13sp" android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/et_lib_norte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="end"
                        android:hint="0.000"
                        android:inputType="numberDecimal"
                        android:minWidth="120dp"
                        android:textColor="@color/accent_orange"
                        android:textColorHint="@color/accent_orange"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" m" android:textColor="@color/accent_orange" android:textSize="16sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/label_alt_z" android:textColor="@color/accent_light" android:textSize="13sp" android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/et_lib_cota"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="end"
                        android:hint="0.000"
                        android:inputType="numberDecimal"
                        android:minWidth="120dp"
                        android:textColor="@color/accent_orange"
                        android:textColorHint="@color/accent_orange"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" m" android:textColor="@color/accent_orange" android:textSize="16sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- OBSERVACIONES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_field_obs"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/et_lib_obs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_spinner_with_arrow"
                android:backgroundTint="@color/bg_surface_secondary"
                android:hint="Ej: Clavo sobre estaca cerca al río."
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top|start" />

            <!-- BOTONES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_lib_cancelar"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/btn_cancel"
                    android:textColor="@color/state_error"
                    app:strokeColor="@color/state_error"
                    app:strokeWidth="1.2dp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_lib_guardar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_save_notebook"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_orange"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
