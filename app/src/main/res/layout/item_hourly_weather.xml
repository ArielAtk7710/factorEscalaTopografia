<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_hourly"
    android:layout_width="85dp"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/bg_surface_secondary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="12dp"
        android:paddingHorizontal="4dp"
        android:gravity="center">

        <TextView
            android:id="@+id/txt_hourly_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/img_hourly_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginVertical="6dp"
            app:srcCompat="@drawable/ic_weather_night"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/txt_hourly_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="16°"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_hourly_wind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 km/h"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                app:srcCompat="@drawable/ic_info"
                app:tint="@color/accent_light"
                android:layout_marginEnd="2dp"/>

            <TextView
                android:id="@+id/txt_hourly_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/accent_light"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
