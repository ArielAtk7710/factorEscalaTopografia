<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_settings"
        android:textColor="@color/accent_orange"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Language Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_language"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="3dp" />

            <Spinner
                android:id="@+id/sp_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_spinner_with_arrow"
                android:padding="12dp"
                android:layout_marginBottom="6dp" />

            <!-- Geoidal Model Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_geoid_adjustment"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_geoid_model"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:singleSelection="true"
                    app:selectionRequired="true">
                    <Button
                        android:id="@+id/btn_geoid_mgb"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/opt_mgb"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/toggle_button_background_selector"
                        android:textColor="@color/toggle_button_text_selector"
                        app:strokeColor="@color/accent_orange" />
                    <Button
                        android:id="@+id/btn_geoid_egm96"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/opt_egm96"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/toggle_button_background_selector"
                        android:textColor="@color/toggle_button_text_selector"
                        app:strokeColor="@color/accent_orange" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <ImageButton
                    android:id="@+id/btn_geoid_info"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_geoid_info"
                    android:src="@drawable/ic_info_round_blue"
                    android:scaleType="centerInside" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_pressure_adjustment"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <EditText
                    android:id="@+id/et_pressure_offset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_spinner_with_arrow"
                    android:backgroundTint="@color/bg_surface_secondary"
                    android:hint="@string/hint_pressure_adjustment"
                    android:padding="12dp"
                    android:textColor="@color/accent_orange"
                    android:textStyle="bold"
                    android:inputType="numberDecimal|numberSigned" />

                <ImageButton
                    android:id="@+id/btn_barometer_info"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_info_round_blue"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/btn_info_barometer" />
            </LinearLayout>

            <!-- Sección Ruta de Mapas Exportados -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/label_map_export_path"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@color/bg_surface"
                android:padding="12dp"
                android:text="@string/text_export_path"
                android:textColor="@color/accent_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- SECCIÓN MAPAS -->
                        <!-- Modo del mapa -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/label_map_mode"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_map_mode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <Button
                        android:id="@+id/btn_mode_online"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="false"
                        android:focusable="false"
                        android:text="@string/opt_online"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/accent_orange"
                        app:strokeColor="@color/accent_orange" />

                    <Button
                        android:id="@+id/btn_mode_offline_aesthetic"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/opt_offline"
                        android:textColor="@color/accent_orange"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:strokeColor="@color/accent_orange" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <ImageButton
                    android:id="@+id/btn_map_info"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_map_info"
                    android:src="@drawable/ic_info_round_blue"
                    android:scaleType="centerInside" />
            </LinearLayout>

            <!-- Caché (Fila Horizontal) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/label_cache"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Caché Única (Callejero y Satelital) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/bg_surface"
                    android:padding="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_cache_street"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/txt_cache_size_street"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 MB"
                        android:textColor="@color/accent_orange"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_cache_street"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_clean"
                    android:textSize="9sp"
                    android:paddingHorizontal="8dp"
                    app:strokeColor="@color/state_error"
                    android:textColor="@color/state_error" />
            </LinearLayout>


            <!-- GPS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_gps_settings"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_show_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_show_location"
                android:textColor="@color/text_primary"
                android:checked="true" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_real_time_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_real_time_update"
                android:textColor="@color/text_primary"
                android:checked="true"
                android:layout_marginBottom="6dp" />


            <!-- Theme Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/label_theme"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@color/bg_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txt_theme_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_dark_mode"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_theme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/switch_thumb_selector"
                    app:trackTint="@color/switch_track_selector" />
            </LinearLayout>

            <!-- Divider / License Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/title_license"
                    android:textColor="@color/accent_orange"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btn_license_info_toast"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_info_round_blue"
                    app:tint="@color/accent_orange"
                    android:padding="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/msg_license_benefits_info" />
            </LinearLayout>

            <!-- License Card Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_surface"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_license_type"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txt_license_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DEMO"
                        android:textColor="@color/accent_orange"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_license_status"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txt_license_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_license_active"
                        android:textColor="@color/state_success"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_expiration_date"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txt_license_expiration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30/10/2026"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_remaining_days"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txt_license_days_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 días"
                        android:textColor="@color/accent_orange"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Text code input and activate button -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/label_activation_code"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/et_activation_code"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_spinner_with_arrow"
                    android:backgroundTint="@color/bg_surface_secondary"
                    android:hint="@string/hint_activation_code"
                    android:inputType="textCapCharacters|textVisiblePassword"
                    android:maxLength="8"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/accent_orange"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_activate_license"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_activate_license"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_orange"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="0dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_request_license_whatsapp"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/btn_get_license_whatsapp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_whatsapp"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconTint="@android:color/white"
                    app:backgroundTint="#25D366"
                    android:textColor="@android:color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_official_website"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="@string/btn_official_website"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_web"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconTint="@android:color/white"
                    app:backgroundTint="@color/accent_primary"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/msg_restart_required"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btn_close_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_understood"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        app:backgroundTint="@color/accent_primary" />

</LinearLayout>
