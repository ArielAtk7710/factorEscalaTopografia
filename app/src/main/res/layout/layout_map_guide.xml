<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txt_guide_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TÍTULO DE GUÍA"
            android:textColor="@color/accent_orange"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txt_guide_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instrucciones paso a paso..."
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toca fuera para cerrar"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            android:gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:textStyle="italic" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
