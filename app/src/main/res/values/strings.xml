    <!-- Professional Topographic Alerts -->
    <string name="safety_solar_title">Interferencia Ionosférica (Kp Alto)</string>
    <string name="safety_solar_desc">La alta actividad solar está perturbando la ionosfera, lo que retrasa la señal de los satélites. Es probable que experimentes pérdida de precisión centimétrica o falsos \"FIX\" en equipos RTK.</string>
    <string name="safety_solar_rec">Recomendación: Aumenta el tiempo de lectura de tus puntos o pospón levantamientos de alta precisión.</string>

    <string name="safety_geometry_title">Geometría Satelital Deficiente</string>
    <string name="safety_geometry_desc">Los satélites visibles están agrupados en una sola zona del cielo o hay muy pocos disponibles, aumentando el margen de error métrico.</string>
    <string name="safety_geometry_rec">Recomendación: Evita tomar puntos de control críticos. Aléjate de edificios altos, cañadones o árboles densos que bloqueen el horizonte.</string>

    <string name="safety_wind_title">Alerta de Vientos Fuertes</string>
    <string name="safety_wind_desc">Se detectan ráfagas que superan el límite seguro de operación. Esto causará vibraciones severas en el bastón RTK (error de plomada) y riesgo de accidente en drones.</string>
    <string name="safety_wind_rec">Recomendación: Cancela los vuelos aerofotogramétricos y asegura firmemente el bípode si realizas estática.</string>

    <string name="safety_storm_title">Condiciones Atmosféricas Adversas</string>
    <string name="safety_storm_desc">Las nubes densas y precipitaciones fuertes pueden generar refracción troposférica y degradar la señal de radio UHF entre la base y el rover.</string>
    <string name="safety_storm_rec">Recomendación: Protege los equipos electrónicos del agua y suspende el vuelo de drones (riesgo de pérdida de señal y daños en motores).</string>

    <string name="safety_optimal_title">Ventana de Operación Óptima</string>
    <string name="safety_optimal_desc">El clima espacial (actividad solar) y las condiciones atmosféricas son estables. Las señales GNSS viajan sin interferencias mayores.</string>
    <string name="safety_optimal_rec">Recomendación: Excelente momento para levantamientos RTK, estática de alta precisión y vuelos fotogramétricos automatizados.</string>
    <string name="safety_msg_rain_detected">Alerta Roja: Lluvia detectada (%1$.1f mm). Riesgo de cortocircuito.</string>
    <string name="safety_msg_rain_prob_mid">Alerta Amarilla: Riesgo de lluvia (%1$d%%). Vuelo bajo supervisión.</string>
