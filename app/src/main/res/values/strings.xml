    <!-- Dialogs -->
    <!-- Map Help Strings -->
    <string name="title_map_download_guide">GUÍA DE OBTENCIÓN DE MAPAS</string>
    <string name="msg_map_download_instr">1. Descarga el archivo: Puedes obtener extractos de OpenStreetMap (formatos .sqlite o .mbtiles) desde fuentes como BBBike o usar herramientas como Mobile Atlas Creator (MOBAC).\n\n2. Ruta de instalación: Debes copiar el archivo a esta ruta exacta: Almacenamiento Interno > Android > data > bo.com.factorcombinadotopo > files > osmdroid\n\n3. Una vez copiado, la app habilitará los modos Híbrido y Offline.</string>

    <string name="title_map_import_guide">GUÍA DE IMPORTACIÓN</string>
    <string name="msg_map_import_instr">1. Presiona el botón "IMPORTAR MAPA".\n\n2. Selecciona tu archivo de mapa (.sqlite o .mbtiles) desde tu explorador de archivos.\n\n3. Espera el mensaje de confirmación.\n\n4. La app copiará el archivo internamente por ti.</string>

