    <!-- Professional Topographic Alerts -->
    <string name="safety_solar_title">Interférence Ionosphérique (Kp Élevé)</string>
    <string name="safety_solar_desc">La forte activité solaire perturbe l\'ionosphère, retardant le signal des satellites. Il est probable que vous constatiez une perte de précision centimétrique ou de faux \"FIX\" sur les équipements RTK.</string>
    <string name="safety_solar_rec">Recommandation : Augmentez le temps de lecture de vos points ou reportez les levés de haute précision.</string>

    <string name="safety_geometry_title">Mauvaise Géométrie Satellitaire</string>
    <string name="safety_geometry_desc">Les satellites visibles sont regroupés dans une seule zone du ciel ou trop peu sont disponibles, augmentant la marge d\'erreur métrique.</string>
    <string name="safety_geometry_rec">Recommandation : Évitez de prendre des points de contrôle critiques. Éloignez-vous des bâtiments élevés, des canyons ou des arbres denses qui bloquent l\'horizon.</string>

    <string name="safety_wind_title">Alerte de Vents Forts</string>
    <string name="safety_wind_desc">Des rafales dépassant la limite de sécurité d\'opération sont détectées. Cela causera des vibrations sévères sur la canne RTK (erreur de plomb) et un risque d\'accident pour les drones.</string>
    <string name="safety_wind_rec">Recommandation : Annulez les vols photogrammétriques et fixez fermement le bipied si vous effectuez des levés statiques.</string>

    <string name="safety_storm_title">Conditions Atmosphériques Adverses</string>
    <string name="safety_storm_desc">Les nuages denses et les précipitations fortes peuvent générer une réfraction troposphérique et dégrader le signal radio UHF entre la base et le mobile.</string>
    <string name="safety_storm_rec">Recommandation : Protégez les équipements électroniques de l\'eau et suspendez le vol des drones (risque de perte de signal et de dommages aux moteurs).</string>

    <string name="safety_optimal_title">Fenêtre d\'Opération Optimale</string>
    <string name="safety_optimal_desc">La météo spatiale (activité solaire) et les conditions atmosphériques sont stables. Les signaux GNSS voyagent sans interférences majeures.</string>
    <string name="safety_optimal_rec">Recommandation : Excellent moment pour les levés RTK, la statique de haute précision et les vols photogrammétriques automatisés.</string>
    <string name="safety_msg_rain_detected">Alerte Rouge : Pluie détectée (%1$.1f mm). Risque de court-circuit.</string>
    <string name="safety_msg_rain_prob_mid">Alerte Jaune : Risque de pluie (%1$d%%). Vol sous surveillance.</string>
