    <!-- Quick Guide Content -->
    <string name="title_quick_guide">📖 Guide Rapide d\'Utilisation</string>

    <string name="guide_section_gen_title">1. Concepts Généraux</string>
    <string name="guide_section_gen_body">FactorEscalaTop est une suite topographique pour le calcul des facteurs de correction (k, ha, K) et la gestion des données GNSS, calibrée spécifiquement pour la Bolivie.</string>

    <string name="guide_section_calc_title">2. Modes de Calcul</string>
    <string name="guide_section_calc_body"><b>Automatique :</b> Obtient des données en temps réel du GPS.\n<b>Manuel :</b> Permet de simuler des scénarios en saisissant des coordonnées de plans ou de projets.</string>

    <string name="guide_section_map_title">3. Navigation et Carte</string>
    <string name="guide_section_map_body"><b>Viseur Orange :</b> Votre objectif central.\n<b>Recherche (Loupe) :</b> Appuyez sur le panneau supérieur pour naviguer vers des coordonnées exactes.\n<b>Aiguilles Orange :</b> Marques temporaires de session qui vous suivent dans toute l\'application.</string>

    <string name="guide_section_alt_title">4. Altitude et Modèles DEM</string>
    <string name="guide_section_alt_body"><b>GPS Appareil :</b> Altitude ellipsoïdale du mobile.\n<b>Hauteur en Ligne :</b> Obtient l\'élévation (MSL) via l\'API Open-Meteo (Copernicus DEM) avec correction EGM2008.</string>

    <string name="guide_section_drone_title">5. Assistant de Vol</string>
    <string name="guide_section_drone_body">Analyse la sécurité des drones via un feu tricolore (Vert à Rouge) basé sur les vents, la pluie et l\'indice Kp solaire pour protéger votre signal GPS.</string>

    <string name="guide_section_data_title">6. Gestion des Données</string>
    <string name="guide_section_data_body">Exportez vos relevés en <b>TXT</b> pour les rapports humains ou en <b>JSON</b> pour une intégration directe avec les logiciels SIG/CAO depuis l\'onglet REGISTRES.</string>

