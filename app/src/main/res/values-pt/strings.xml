    <!-- Professional Topographic Alerts -->
    <string name="safety_solar_title">Interferência Ionosférica (Kp Alto)</string>
    <string name="safety_solar_desc">A alta atividade solar está perturbando a ionosfera, o que atrasa o sinal dos satélites. É provável que experimente perda de precisão centimétrica ou falsos \"FIX\" em equipamentos RTK.</string>
    <string name="safety_solar_rec">Recomendação: Aumente o tempo de leitura de seus pontos ou adie levantamentos de alta precisão.</string>

    <string name="safety_geometry_title">Má Geometria Satelital</string>
    <string name="safety_geometry_desc">Os satélites visíveis estão agrupados em uma única zona do céu ou há muito poucos disponíveis, aumentando a margem de erro métrico.</string>
    <string name="safety_geometry_rec">Recomendação: Evite tomar pontos de controle críticos. Afaste-se de edifícios altos, desfiladeiros ou árvores densas que bloqueiem o horizonte.</string>

    <string name="safety_wind_title">Alerta de Ventos Fortes</string>
    <string name="safety_wind_desc">São detectadas rajadas que superam o limite seguro de operação. Isso causará vibrações severas no bastão RTK (erro de prumada) e risco de acidente em drones.</string>
    <string name="safety_wind_rec">Recomendação: Cancele os voos aerofotogramétricos e assegure firmemente o bípode se realizar estática.</string>

    <string name="safety_storm_title">Condições Atmosféricas Adversas</string>
    <string name="safety_storm_desc">As nuvens densas e precipitações fortes podem gerar refração troposférica e degradar o sinal de rádio UHF entre a base e o rover.</string>
    <string name="safety_storm_rec">Recomendação: Proteja os equipamentos eletrônicos da água e suspenda o voo de drones (risco de perda de sinal e danos em motores).</string>

    <string name="safety_optimal_title">Janela de Operação Ótima</string>
    <string name="safety_optimal_desc">O clima espacial (atividade solar) e as condições atmosféricas são estáveis. Os sinais GNSS viajam sem interferências maiores.</string>
    <string name="safety_optimal_rec">Recomendação: Excelente momento para levantamentos RTK, estática de alta precisão e voos fotogramétricos automatizados.</string>
    <string name="safety_msg_rain_detected">Alerta Vermelho: Chuva detectada (%1$.1f mm). Risco de curto-circuito.</string>
    <string name="safety_msg_rain_prob_mid">Alerta Amarelo: Risco de chuva (%1$d%%). Voo sob supervisão.</string>
