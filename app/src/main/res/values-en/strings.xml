    <!-- Professional Topographic Alerts -->
    <string name="safety_solar_title">Ionospheric Interference (High Kp)</string>
    <string name="safety_solar_desc">High solar activity is perturbing the ionosphere, delaying satellite signals. You may experience loss of centimetric precision or false \"FIX\" on RTK equipment.</string>
    <string name="safety_solar_rec">Recommendation: Increase reading time for your points or postpone high-precision surveys.</string>

    <string name="safety_geometry_title">Poor Satellite Geometry</string>
    <string name="safety_geometry_desc">Visible satellites are grouped in a single sky area or too few are available, increasing metric error margin.</string>
    <string name="safety_geometry_rec">Recommendation: Avoid taking critical control points. Stay away from tall buildings, canyons, or dense trees blocking the horizon.</string>

    <string name="safety_wind_title">High Winds Alert</string>
    <string name="safety_wind_desc">Gusts exceeding safe operation limits detected. This will cause severe vibrations in RTK poles (plumbing error) and crash risk for drones.</string>
    <string name="safety_wind_rec">Recommendation: Cancel photogrammetric flights and firmly secure the bipod if performing static surveys.</string>

    <string name="safety_storm_title">Adverse Atmospheric Conditions</string>
    <string name="safety_storm_desc">Dense clouds and heavy rainfall can generate tropospheric refraction and degrade UHF radio signal between base and rover.</string>
    <string name="safety_storm_rec">Recommendation: Protect electronic equipment from water and suspend drone flights (risk of signal loss and motor damage).</string>

    <string name="safety_optimal_title">Optimal Operative Window</string>
    <string name="safety_optimal_desc">Space weather (solar activity) and atmospheric conditions are stable. GNSS signals travel without major interference.</string>
    <string name="safety_optimal_rec">Recommendation: Excellent time for RTK surveys, high-precision static, and automated photogrammetric flights.</string>
    <string name="safety_msg_rain_detected">Red Alert: Rain detected (%1$.1f mm). Risk of short circuit.</string>
    <string name="safety_msg_rain_prob_mid">Yellow Alert: Risk of rain (%1$d%%). Flight under supervision.</string>
